# ---------------------------------------------------------------------------
# memory-agent-benchmark — branch: openai-memoryareena-nasir
# Copy this file to .env and fill in the values. NEVER commit .env.
# Secrets live ONLY in .env. They are never stored in code, configs, tests,
# the Dockerfile, or the README.
# ---------------------------------------------------------------------------

# === LLM provider ==========================================================
# This branch uses direct OpenAI (not OpenRouter).
LLM_PROVIDER=openai

# === OpenAI direct API =====================================================
OPENAI_API_KEY=
# Latest frontier model (see https://developers.openai.com/api/docs/models)
OPENAI_MODEL=gpt-5.5

# === OpenRouter (unused on this branch; kept for reference) ================
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_TITLE=memory-agent-benchmark
# OPENROUTER_USE_LATEST_ALIASES=true
# OPENROUTER_RESOLVE_LATEST_ONCE=true
# OPENROUTER_STRICT_BENCHMARK_MODE=true
# OPENROUTER_ALLOW_FALLBACKS=false
# OPENROUTER_REQUIRE_PARAMETERS=true
# OPENROUTER_DATA_COLLECTION=deny

# === Self-hosted memory system endpoints (internal Docker network) =========
# These point at self-hosted backends reachable over the internal compose
# network. Adapters degrade gracefully (log "unavailable") if unreachable.
# Vectorize Hindsight API (default port 8888, not 8000).
HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:latest
HINDSIGHT_BASE_URL=http://hindsight-server:8888
HINDSIGHT_API_KEY=
# LLM used *inside* the Hindsight container (memory extraction). Kept cheap +
# consistent across memory systems (isolates the architecture, not the LLM).
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini

# AContext runs as its own stack (acontext_server/, started by `make acontext`).
# The benchmark reaches its API on the host via host.docker.internal:8029.
# The default-project SDK key is sk-ac-<ACONTEXT_ROOT_TOKEN> (see RUNBOOK).
ACONTEXT_BASE_URL=http://host.docker.internal:8029/api/v1
ACONTEXT_API_KEY=
MEM0_BASE_URL=http://mem0-qdrant:6333
MEM0_API_KEY=
# LLM mem0 uses internally for fact extraction (cheap; same as above).
MEM0_LLM_MODEL=gpt-4o-mini
ZEP_BASE_URL=http://zep:8000
ZEP_API_KEY=
# supermemory is DISABLED (closed-source backend); kept for reference only.
SUPERMEMORY_BASE_URL=http://supermemory:8000
SUPERMEMORY_API_KEY=

# === Benchmark scope (cost-efficient default) ===============================
# Scale preset: memoryarena_shopping | memoryarena_reasoning | memoryarena_100 | paper | full | smoke
# memoryarena_shopping = MemoryArena bundled_shopping, 40 tasks (random, seed 42), 3 runs.
BENCHMARK_PROFILE=memoryarena_shopping
BENCHMARKS=memoryarena
MEMORYARENA_CONFIGS=bundled_shopping
MAX_TASKS_TOTAL=40
MAX_TASKS_PER_DOMAIN=0
TASK_SAMPLE_STRATEGY=random
BENCHMARK_TASK_SEED=42
DEFAULT_NUM_RUNS=3
# Single model slot on this branch
MODELS=openai_frontier

# === Execution =============================================================
MODEL_PARALLELISM=1
TASK_PARALLELISM=8                 # main speed lever; lower if you hit rate-limit backoff.
RETRIEVE_TOP_K=3
# Leave RUN_ID empty to auto-generate; set explicitly after `source scripts/init_run.sh`
RUN_ID=
