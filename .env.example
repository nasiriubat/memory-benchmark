# ---------------------------------------------------------------------------
# memory-agent-benchmark — branch: openai-memoryareena-nasir
# Copy this file to .env and fill in the values. NEVER commit .env.
# Secrets live ONLY in .env. They are never stored in code, configs, tests,
# the Dockerfile, or the README.
# ---------------------------------------------------------------------------

# === LLM provider ==========================================================
# This branch uses direct OpenAI (not OpenRouter).
LLM_PROVIDER=openai

# === OpenAI direct API =====================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Latest frontier model (see https://developers.openai.com/api/docs/models)
OPENAI_MODEL=gpt-5.5

# === OpenRouter (unused on this branch; kept for reference) ================
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_TITLE=memory-agent-benchmark
# OPENROUTER_USE_LATEST_ALIASES=true
# OPENROUTER_RESOLVE_LATEST_ONCE=true
# OPENROUTER_STRICT_BENCHMARK_MODE=true
# OPENROUTER_ALLOW_FALLBACKS=false
# OPENROUTER_REQUIRE_PARAMETERS=true
# OPENROUTER_DATA_COLLECTION=deny

# === Self-hosted memory system endpoints (internal Docker network) =========
# These point at self-hosted backends reachable over the internal compose
# network. Adapters degrade gracefully (log "unavailable") if unreachable.
# Vectorize Hindsight API (default port 8888, not 8000).
HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:latest
HINDSIGHT_BASE_URL=http://hindsight-server:8888
HINDSIGHT_API_KEY=
# LLM used *inside* the Hindsight container (memory extraction).
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_MODEL=gpt-5.5

ACONTEXT_BASE_URL=http://acontext:8000
ACONTEXT_API_KEY=
MEM0_BASE_URL=http://mem0-qdrant:6333
MEM0_API_KEY=
ZEP_BASE_URL=http://zep:8000
ZEP_API_KEY=
SUPERMEMORY_BASE_URL=http://supermemory:8000
SUPERMEMORY_API_KEY=

# === Benchmark scope (MemoryArena subset) ===================================
# Scale preset: memoryarena_100 | paper | full | smoke
BENCHMARK_PROFILE=memoryarena_100
BENCHMARKS=memoryarena
MAX_TASKS_TOTAL=100
MAX_TASKS_PER_DOMAIN=0
TASK_SAMPLE_STRATEGY=random
BENCHMARK_TASK_SEED=42
DEFAULT_NUM_RUNS=5
# Single model slot on this branch
MODELS=openai_frontier

# === Execution =============================================================
MODEL_PARALLELISM=1
TASK_PARALLELISM=1
RETRIEVE_TOP_K=3
# Leave RUN_ID empty to auto-generate; set explicitly after `source scripts/init_run.sh`
RUN_ID=
