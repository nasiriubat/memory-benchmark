# ---------------------------------------------------------------------------
# memory-agent-benchmark environment configuration.
# Copy this file to .env and fill in the values. NEVER commit .env.
# Secrets live ONLY in .env. They are never stored in code, configs, tests,
# the Dockerfile, or the README.
# ---------------------------------------------------------------------------

# === OpenRouter (the ONLY LLM API provider used for model calls) ===========
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=memory-agent-benchmark
OPENROUTER_USE_LATEST_ALIASES=true
OPENROUTER_RESOLVE_LATEST_ONCE=true
OPENROUTER_STRICT_BENCHMARK_MODE=true
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_DATA_COLLECTION=deny

# === Self-hosted memory system endpoints (internal Docker network) =========
# These point at self-hosted backends reachable over the internal compose
# network. Adapters degrade gracefully (log "unavailable") if unreachable.
# Vectorize Hindsight API (default port 8888, not 8000).
HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:latest
HINDSIGHT_BASE_URL=http://hindsight-server:8888
HINDSIGHT_API_KEY=
# LLM used *inside* the Hindsight container (extraction). Defaults to OpenRouter in compose.
# If unset, docker-compose uses OPENROUTER_API_KEY from this file.
HINDSIGHT_API_LLM_PROVIDER=openrouter
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_MODEL=openai/gpt-4o-mini
# Or use OpenAI directly: HINDSIGHT_API_LLM_PROVIDER=openai and HINDSIGHT_API_LLM_API_KEY=<openai-key>
ACONTEXT_BASE_URL=http://acontext:8000
ACONTEXT_API_KEY=
MEM0_BASE_URL=http://mem0-qdrant:6333
MEM0_API_KEY=
ZEP_BASE_URL=http://zep:8000
ZEP_API_KEY=
SUPERMEMORY_BASE_URL=http://supermemory:8000
SUPERMEMORY_API_KEY=

# === Run parameters ========================================================
# Scale preset: paper (50 tasks/config, 5 runs) | full (no cap) | smoke (1 task)
BENCHMARK_PROFILE=paper
DEFAULT_NUM_RUNS=5
MAX_TASKS_PER_DOMAIN=50
MODEL_PARALLELISM=1
TASK_PARALLELISM=1
RETRIEVE_TOP_K=3
# Leave RUN_ID empty to auto-generate a fresh, reproducible run id per run.
RUN_ID=
